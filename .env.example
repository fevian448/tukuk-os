# Salin ke .env atau export sebagai environment variables.
# JANGAN commit kunci sebenar ke repository.

HOST=0.0.0.0
PORT=8000

MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=ganti_dengan_kunci_anda
MEILI_INDEX=halaman_web
MEILI_DB_PATH=./meili_data
MEILI_TIMEOUT=30000

CRAWLER_UA=TukukOS-Bot/1.0 (+https://tukuk.org/bot)
CRAWL_CONCURRENCY=4
CRAWL_QUEUE_LIMIT=5000
CRAWL_TIMEOUT=15000
CRAWL_MAX_BYTES=3145728
CRAWL_MAX_REDIRECTS=3
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES=200
CRAWL_RESPECT_ROBOTS=true
CRAWL_ALLOW_PRIVATE=false

CONTENT_CHARS=6000
SUMMARY_CHARS=400

SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_CROP_LENGTH=30
SEARCH_TIMEOUT_MS=1000
SEARCH_PRE_TAG=<mark>
SEARCH_POST_TAG=</mark>

LOG_REQUESTS=1
# rate limiting & security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=true
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_WRITE_MAX=10
RATE_LIMIT_CRAWL_MAX=5
SEARCH_CACHE_SECONDS=60
WEBSEARCH_ENABLED=true
WEBSEARCH_PROVIDER=duckduckgo
WEBSEARCH_TIMEOUT=15000
WEBSEARCH_MAX_RESULTS=10
WEBSEARCH_CACHE_SECONDS=300
WEBSEARCH_UA=TukukOS-WebSearch/1.0
API_KEY=

# AdSense (ID slot dari dashboard AdSense -> "By ad unit")
ADSENSE_ENABLED=true
ADSENSE_CLIENT=ca-pub-8954948214333501
ADSENSE_SLOT_TOP=0000000000
ADSENSE_SLOT_IN_ARTICLE=0000000000
ADSENSE_SLOT_BOTTOM=0000000000
